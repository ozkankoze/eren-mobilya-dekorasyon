# YÖNETİM PANELİ (/admin)
# Bu değişkenler Vercel → Settings → Environment Variables altına eklenir.
# Tanımlı değillerse site normal çalışır, yalnızca panel devre dışı kalır.

# Panele giriş şifresi
ADMIN_PASSWORD=

# Oturum çerezini imzalayan gizli anahtar
# Üretmek için:  openssl rand -base64 32
ADMIN_SECRET=

# Vercel Blob deposunu projeye bağladığınızda otomatik gelir
BLOB_READ_WRITE_TOKEN=

# ---- SEO (isteğe bağlı) ----
# Google Search Console / Yandex Webmaster doğrulama kodları.
# Tanımlı değilse doğrulama etiketi hiç basılmaz.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Google etiketi (Google Ads dönüşüm ölçümü).
# Tanımsızsa lib/site.ts içindeki varsayılan kullanılır.
# Etiketi tamamen kapatmak için boş bırakın: NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=
